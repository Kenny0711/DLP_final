<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Full experiment (morning→off→evening) — merged from 忠孝x復興南 + 忠孝x敦化 -->
    <vType id="car" accel="2.6" decel="4.5" length="5" maxSpeed="13.9" sigma="0.5"/>

    <!-- morning_peak : 0~3600s -->
    <flow id="morning_peak_EB" type="car" from="W2C" to="C2E" begin="0" end="3600" vehsPerHour="319"/>
    <flow id="morning_peak_WB" type="car" from="E2C" to="C2W" begin="0" end="3600" vehsPerHour="489"/>
    <flow id="morning_peak_NB" type="car" from="S2C" to="C2N" begin="0" end="3600" vehsPerHour="138"/>
    <flow id="morning_peak_SB" type="car" from="N2C" to="C2S" begin="0" end="3600" vehsPerHour="153"/>

    <!-- off_peak : 3600~7200s -->
    <flow id="off_peak_EB" type="car" from="W2C" to="C2E" begin="3600" end="7200" vehsPerHour="331"/>
    <flow id="off_peak_WB" type="car" from="E2C" to="C2W" begin="3600" end="7200" vehsPerHour="418"/>
    <flow id="off_peak_NB" type="car" from="S2C" to="C2N" begin="3600" end="7200" vehsPerHour="91"/>
    <flow id="off_peak_SB" type="car" from="N2C" to="C2S" begin="3600" end="7200" vehsPerHour="102"/>

    <!-- evening_peak : 7200~10800s -->
    <flow id="evening_peak_EB" type="car" from="W2C" to="C2E" begin="7200" end="10800" vehsPerHour="349"/>
    <flow id="evening_peak_WB" type="car" from="E2C" to="C2W" begin="7200" end="10800" vehsPerHour="657"/>
    <flow id="evening_peak_NB" type="car" from="S2C" to="C2N" begin="7200" end="10800" vehsPerHour="203"/>
    <flow id="evening_peak_SB" type="car" from="N2C" to="C2S" begin="7200" end="10800" vehsPerHour="225"/>

</routes>
